# ─── Telegram ────────────────────────────────────────────────────────────────
# Real bot token from @BotFather. NOT required for mock mode (the default).
# NEVER commit the real .env file.
# BOT_TOKEN=123456:ABC-DEF1234ghIkl-zyx57W2v1u123ew11

# Bot username (placeholder until a real bot is created via @BotFather).
BOT_USERNAME=file_to_link_bot

# Bot mode: "mock" (default, no token required) or "real".
# When unset, mock is used unless BOT_TOKEN is provided.
BOT_MODE=mock

# ─── Real Telegram (only needed for BOT_MODE=real) ───────────────────────────
# Free api_id/api_hash for the Local Bot API Server — get them from
# https://my.telegram.org (NOT the same as BOT_TOKEN). Required by the
# self-hosted server, not by this app directly.
# TELEGRAM_API_ID=
# TELEGRAM_API_HASH=

# URL of your self-hosted Telegram Local Bot API Server (run with --local).
# Keep it private — it speaks plain HTTP. Our app connects here instead of
# api.telegram.org.
LOCAL_BOT_API_URL=http://127.0.0.1:8081

# Working directory of the Local Bot API Server (its --dir option).
# Received files are stored here; TelegramFileSource only serves files
# under this directory. Relative paths resolve against the project root.
TELEGRAM_BOT_WORK_DIR=telegram_bot_data

# ─── Server / links ──────────────────────────────────────────────────────────
# Public base URL for generated file links: {BASE_URL}/f/{public_id}.
# Must include a scheme. Trailing slashes are tolerated.
BASE_URL=http://localhost:8000

# Host/port the download API binds to. HOST defaults to loopback only;
# binding to 0.0.0.0 exposes the API beyond this machine (the server warns).
HOST=127.0.0.1
PORT=8000

# ─── Security / abuse protection (Phase 11) ──────────────────────────────────
# Per-client rate limit for GET/HEAD /f/{public_id}: at most
# RATE_LIMIT_REQUESTS requests per RATE_LIMIT_WINDOW_SECONDS, then HTTP 429
# with Retry-After. Set RATE_LIMIT_ENABLED=false to disable.
# The limiter is in-process (no Redis); keys are client identities, never link
# ids, and RATE_LIMIT_MAX_KEYS bounds how many clients are tracked.
RATE_LIMIT_ENABLED=true
RATE_LIMIT_REQUESTS=60
RATE_LIMIT_WINDOW_SECONDS=60
RATE_LIMIT_MAX_KEYS=10000

# Proxy trust. By default the rate-limit key is the real TCP peer address and
# X-Forwarded-For is IGNORED (a client cannot spoof its identity). Only behind
# a reverse proxy: set TRUST_PROXY_HEADERS=true AND list the proxy's IP(s) in
# TRUSTED_PROXIES; the forwarded address is trusted only from those IPs.
# TRUST_PROXY_HEADERS=true with an empty TRUSTED_PROXIES is rejected at startup.
TRUST_PROXY_HEADERS=false
# TRUSTED_PROXIES=127.0.0.1

# ─── Database ────────────────────────────────────────────────────────────────
# SQLite database file. Relative paths resolve against the project root.
# Auto-created on first run (parent directory created if missing).
DATABASE_PATH=data/files.db