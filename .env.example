# ─── Telegram ────────────────────────────────────────────────────────────────
# Real bot token from @BotFather. NOT required in the current milestone:
# the project runs on a mock Telegram transport until the real integration
# lands. NEVER commit the real .env file.
# BOT_TOKEN=

# Bot username (placeholder until a real bot is created via @BotFather).
BOT_USERNAME=file_to_link_bot

# Bot mode: "mock" (default, no token required) or "real" (later phase).
# When unset, mock is used unless BOT_TOKEN is provided.
BOT_MODE=mock

# ─── Server / links ──────────────────────────────────────────────────────────
# Public base URL for generated file links: {BASE_URL}/f/{public_id}.
# Must include a scheme. Trailing slashes are tolerated.
BASE_URL=http://localhost:8000

# Host/port used when the download API ships (Phase 5+).
HOST=127.0.0.1
PORT=8000

# ─── Database ────────────────────────────────────────────────────────────────
# SQLite database file. Relative paths resolve against the project root.
# Auto-created on first run (parent directory created if missing).
DATABASE_PATH=data/files.db